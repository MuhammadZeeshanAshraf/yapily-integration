{
  "name": "yapily-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "xlint": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky",
    "migration:run": "pnpx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d ./src/common/database/dbConfig.ts",
    "migration:generate": "cross-env pnpx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:generate ./src/common/database/migrations/migration -d ./src/common/database/dbConfig.ts",
    "migration:create": "cross-env pnpx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:create ./src/common/database/migrations/%npm_config_name% -d ./src/common/database/dbConfig.ts",
    "migration:revert": "pnpx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d ./src/common/database/dbConfig.ts",
    "migration:show": "pnpx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:show -d ./src/common/database/dbConfig.ts",
    "prebuild": "npm install --save-dev",
    "preinstall": "",
    "typeorm": "pnpx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.2",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.7.2",
    "body-parser": "^1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.0.11",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint src/ --fix"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
